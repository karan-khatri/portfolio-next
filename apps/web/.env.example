NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — search engine site-verification codes (Google Search Console /
# Bing Webmaster Tools "HTML tag" method). Paste just the content value from
# the <meta name="..." content="..."> snippet each tool gives you, not the
# whole tag. Without these set, no verification meta tags render — harmless.
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION="..."

# Optional — overrides scripts/seed.ts's default dev admin (admin@example.com /
# dev-password-change-me). Set these locally to seed your real admin account;
# never put real values here in the committed .env.example.
# SEED_ADMIN_EMAIL="you@example.com"
# SEED_ADMIN_PASSWORD="a real password, not this one"

# Optional — email notifications (contact form -> you, invite links -> invitee)
# via Resend (https://resend.com). Without both set, sendEmail() just logs and
# no-ops — nothing else breaks. RESEND_FROM_EMAIL must be an address on a
# domain verified in your Resend account (or their onboarding@resend.dev
# shared sender for testing before you verify a domain).
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Portfolio <notifications@yourdomain.com>"

# Local Docker Postgres (docker-compose.yml) — no TLS, leave DATABASE_CA_CERT unset.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# Managed Postgres (e.g. Aiven) instead — requires TLS, and DATABASE_CA_CERT below
# for the runtime connection to verify the server's certificate. `sslmode=require`
# alone is enough for the Prisma CLI (migrate/studio), which can't consume a custom
# CA — see packages/db/src/client.ts for where the CA is actually enforced.
# DATABASE_URL="postgresql://user:password@host:port/defaultdb?sslmode=require"
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# Optional — AI Blog Generator (admin > AI Blog Generator). Server-side only;
# never prefix these with NEXT_PUBLIC_. Without EXPLABS_API_KEY the page loads
# but the Generate button is disabled. The API must be OpenAI-compatible
# (POST {EXPLABS_BASE_URL}/chat/completions with Bearer auth).
# EXPLABS_API_KEY=""
# EXPLABS_BASE_URL="https://api.experientiallabs.ai/v1"
# EXPLABS_MODEL="claude-haiku-5.5"
