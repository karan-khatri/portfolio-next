generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  isPermanent Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  assignments  UserRoleAssignment[]
  inviteTokens InviteToken[]
}

// Two invariants live only in app code (packages/db/src/auth.ts's
// assertRoleTimeFrame) today; a migration additionally enforces them at the
// DB level via raw SQL Prisma's schema DSL can't express natively:
//   - CHECK: expiresAt IS NULL OR expiresAt > startsAt
//   - TRIGGER: a row referencing an isPermanent Role must have expiresAt NULL
// (Overlapping active assignments for the same user are NOT constrained at
// the DB level — that needs a GiST EXCLUDE constraint requiring the
// btree_gist extension, which may not be creatable on a managed Postgres
// instance without elevated privileges. Left as an app-level invariant
// pending confirmation that CREATE EXTENSION is safe to run there.)
model UserRoleAssignment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable + SetNull, like AuditLog.userId: this row is the historical
  // record of "who held what role when" and should survive the Role itself
  // being deleted later (Role.roleId was previously a hard Restrict, which
  // meant a Role could never be deleted once anyone had ever held it, even
  // long after the assignment expired).
  roleId      String?
  role        Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  grantedById String?
  grantedBy   User?     @relation("RoleGrantedBy", fields: [grantedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([userId, startsAt])
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String?
  passwordHash    String
  invitedById     String?
  invitedBy       User?                @relation("UserInvites", fields: [invitedById], references: [id])
  invitees        User[]               @relation("UserInvites")
  sessions        Session[]
  auditLogs       AuditLog[]
  revisions       Revision[]
  sentInvites     InviteToken[]        @relation("SentInvites")
  roleAssignments UserRoleAssignment[]
  grantedRoles    UserRoleAssignment[] @relation("RoleGrantedBy")
  uploadedMedia   Media[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model InviteToken {
  id        String @id @default(cuid())
  // SHA-256 hash of a randomBytes(32) token — the raw token is only ever
  // returned once, at creation, and never persisted (mirrors Session.tokenHash).
  tokenHash String @unique
  email     String
  // Nullable + SetNull, same reasoning as UserRoleAssignment.roleId: an old
  // (accepted/expired) invite is a historical record, and shouldn't block
  // deleting the Role it once pointed at.
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roleExpiresAt DateTime?
  // Nullable + SetNull, same reasoning as AuditLog.userId: an invite is a
  // historical record of "who invited whom," and should survive the inviting
  // User being deleted later (this was previously a hard Restrict, which
  // meant a User could never be deleted once they'd sent any invite, ever).
  invitedById   String?
  invitedBy     User?     @relation("SentInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  // Nullable + SetNull: an audit entry is the historical record of what
  // happened, and should survive the acting user being deleted later —
  // it just loses the ability to point at that (now-gone) User row.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Only "en" exists today — this isn't i18n support, just a closed vocabulary
// so a typo ("En", "en-US") can't silently create content that never shows
// up anywhere. Add a value here (and a migration) when a second locale
// actually ships.
enum Locale {
  en
}

// Page/Project/Post revisions share one polymorphic table since Prisma can't
// express a true FK across three unrelated target tables — entityId stays a
// free-text cuid, but entityType is a real enum so a typo can't silently
// create an unreachable row (previously a plain String). Revisions
// deliberately are NOT cascade-deleted when their source entity is removed:
// they're the audit/history trail, which should survive deletion of the
// thing it documents, so an orphaned revision after a delete is expected
// behavior, not a bug.
model Revision {
  id          String             @id @default(cuid())
  entityType  RevisionEntityType
  entityId    String
  status      ContentStatus
  data        Json
  // Bumped whenever the shape written into `data` changes (e.g. a Page
  // section gains/loses a field). Nothing reads this yet — it exists so a
  // future restore/render path can tell "old shape" from "current shape"
  // instead of guessing from missing fields.
  schemaVersion Int              @default(1)
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())

  previewTokens PreviewToken[]

  @@index([entityType, entityId, createdAt])
}

enum RevisionEntityType {
  Page
  Project
  Post
}

model PreviewToken {
  id        String   @id @default(cuid())
  // SHA-256 hash of a randomBytes(32) token — see InviteToken.tokenHash.
  tokenHash String   @unique
  // entityType/entityId are NOT duplicated here — they previously were,
  // independently of `revision`, with nothing keeping the two in sync. Read
  // them off `revision.entityType`/`revision.entityId` instead.
  revisionId String
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// Seo owns the FK back to whichever single entity it belongs to (rather than
// Page/Project/Post each holding an independent unique FK into Seo). That
// makes "one Seo row per entity" a real constraint instead of a convention:
// the DB now cascades the delete when the owning entity is removed, and a
// CHECK constraint (added in the migration) guarantees at most one of
// pageId/projectId/postId is ever set on a given row.
model Seo {
  id              String   @id @default(cuid())
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImageId       String?
  ogImage         Media?   @relation(fields: [ogImageId], references: [id])
  noindex         Boolean  @default(false)
  nofollow        Boolean  @default(false)
  structuredData  Json?
  pageId          String?  @unique
  page            Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  projectId       String?  @unique
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  postId          String?  @unique
  post            Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(308)
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  ipAddress String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model Media {
  id           String   @id @default(cuid())
  // Unique so the same uploaded asset can't end up as two different Media
  // rows referenced inconsistently across Project.coverImage/Post.coverImage/
  // Seo.ogImage — both storage adapters already generate a fresh random key
  // per upload, so a genuine collision only happens on an actual re-upload
  // of the same file, which should reuse the existing row.
  url          String   @unique
  width        Int?
  height       Int?
  blurDataUrl  String?
  altText      String?
  decorative   Boolean  @default(false)
  filename     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  // Was a bare string with no FK — could point at a nonexistent user and
  // couldn't be queried as a relation. SetNull so deleting a user keeps
  // their uploads (and audit trail) around, just unattributed.
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  seoUsages       Seo[]
  projectCovers   Project[]      @relation("ProjectCoverImage")
  postCovers      Post[]         @relation("PostCoverImage")
  galleryUsages   ProjectImage[]
}

model Author {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  imageUrl String?
  bio      String?
  sameAs   String[]
  posts    Post[]
}

enum SectionType {
  HERO
  ABOUT
  PROJECTS
  EXPERIENCE
  EDUCATION
  SKILLS
  LANGUAGES
  SERVICES
  TESTIMONIALS
  BLOG
  CONTACT
  RESUME
  NOW
}

model Page {
  id                String        @id @default(cuid())
  slug              String
  locale             Locale @default(en)
  translationGroupId String
  title             String
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?
  sections          SectionInstance[]
  seo               Seo?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([slug, locale])
  // A translation group must have at most one row per locale — without this,
  // nothing stopped two Pages sharing a translationGroupId from both being
  // "en", which breaks the "one row per locale per group" invariant the
  // translation-group concept depends on.
  @@unique([translationGroupId, locale])
  // Covers the public site's actual read pattern: "published rows in this
  // locale, ordered by publishedAt" (home page, listing pages, [...slug]).
  @@index([locale, status, publishedAt])
}

model SectionInstance {
  id      String      @id @default(cuid())
  pageId  String
  page    Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type    SectionType
  order   Int
  enabled Boolean     @default(true)
  content Json
  // Bumped whenever a section type's content shape changes (a field added,
  // removed, or renamed on HERO/ABOUT/etc). Nothing reads this yet — it's
  // here so section-renderer can eventually branch on "old shape" instead of
  // every future field being implicitly optional forever.
  schemaVersion Int    @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([pageId, order])
}

model Project {
  id                 String        @id @default(cuid())
  slug               String
  locale             Locale @default(en)
  translationGroupId String
  title              String
  excerpt            String?
  body               String?
  coverImageId       String?
  coverImage         Media?        @relation("ProjectCoverImage", fields: [coverImageId], references: [id])
  codeRepository     String?
  liveUrl            String?
  tags               Tag[]         @relation("ProjectTags")
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  featured           Boolean       @default(false)
  // Unique (not just indexed) so two featured projects can't silently share
  // a position — that would make the featured-projects ordering
  // nondeterministic. NULL is exempt from the uniqueness check (Postgres
  // treats NULLs as distinct), which is what we want: only currently-featured
  // rows need a real, unique position.
  featuredOrder      Int?          @unique
  seo                Seo?
  images             ProjectImage[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([slug, locale])
  @@unique([translationGroupId, locale])
  @@index([locale, status, publishedAt])
}

// A project's detail-page image gallery, ordered separately from
// `coverImage` — the cover is used for cards/listings/OG fallback, the
// gallery is additional images shown as a slider on the detail page.
// A join model rather than an implicit many-to-many since Prisma's implicit
// many-to-many can't carry an `order` column.
model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id])
  order     Int
  createdAt DateTime @default(now())

  @@index([projectId, order])
}

model Post {
  id                 String        @id @default(cuid())
  slug               String
  locale             Locale @default(en)
  translationGroupId String
  title              String
  excerpt            String?
  body               String?
  coverImageId       String?
  coverImage         Media?        @relation("PostCoverImage", fields: [coverImageId], references: [id])
  authorId           String?
  author             Author?       @relation(fields: [authorId], references: [id])
  tags               Tag[]         @relation("PostTags")
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  seo                Seo?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([slug, locale])
  @@unique([translationGroupId, locale])
  @@index([locale, status, publishedAt])
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  projects Project[] @relation("ProjectTags")
  posts    Post[]    @relation("PostTags")
}

model Experience {
  id          String   @id @default(cuid())
  locale      Locale @default(en)
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?
  order       Int      @default(0)
}

model Education {
  id          String    @id @default(cuid())
  locale      Locale @default(en)
  institution String
  degree      String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  order       Int       @default(0)
}

// level is CHECKed (1-5, raw SQL in the migration — see UserRoleAssignment's
// comment for why this isn't expressed in the schema DSL) to match what the
// admin form already labels it: "Level (1-5)".
model Skill {
  id       String @id @default(cuid())
  locale   Locale @default(en)
  name     String
  category String?
  level    Int?
  order    Int    @default(0)
}

// No `locale` (unlike its sibling simple-list models): a tech logo/name isn't
// user-facing prose that gets translated, so per-locale rows would just be
// unused duplication. `imageUrl` is intentionally a plain string rather than
// a Media FK — these are meant to be pasted external logo URLs, not files
// run through the admin's upload/Media pipeline.
model TechStackItem {
  id        String   @id @default(cuid())
  name      String   @unique
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Language {
  id          String @id @default(cuid())
  locale      Locale @default(en)
  name        String
  proficiency String
  order       Int    @default(0)
}

model Service {
  id          String  @id @default(cuid())
  locale      Locale @default(en)
  title       String
  description String?
  order       Int     @default(0)
}

model Testimonial {
  id         String  @id @default(cuid())
  locale     Locale @default(en)
  authorName String
  authorRole String?
  quote      String
  avatarUrl  String?
  order      Int     @default(0)
}

model NavigationItem {
  id       String  @id @default(cuid())
  locale   Locale @default(en)
  label    String
  href     String
  order    Int     @default(0)
  parentId String?
  parent   NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavChildren")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}
