generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  isPermanent Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  assignments  UserRoleAssignment[]
  inviteTokens InviteToken[]
}

model UserRoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  grantedById String?
  grantedBy   User?     @relation("RoleGrantedBy", fields: [grantedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([userId, startsAt])
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String?
  passwordHash    String
  invitedById     String?
  invitedBy       User?                @relation("UserInvites", fields: [invitedById], references: [id])
  invitees        User[]               @relation("UserInvites")
  sessions        Session[]
  auditLogs       AuditLog[]
  revisions       Revision[]
  sentInvites     InviteToken[]        @relation("SentInvites")
  roleAssignments UserRoleAssignment[]
  grantedRoles    UserRoleAssignment[] @relation("RoleGrantedBy")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model InviteToken {
  token         String    @id @default(cuid())
  email         String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  roleExpiresAt DateTime?
  invitedById   String
  invitedBy     User      @relation("SentInvites", fields: [invitedById], references: [id])
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Revision {
  id          String        @id @default(cuid())
  entityType  String
  entityId    String
  status      ContentStatus
  data        Json
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  previewTokens PreviewToken[]

  @@index([entityType, entityId, createdAt])
}

model PreviewToken {
  token      String   @id @default(cuid())
  entityType String
  entityId   String
  revisionId String
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Seo {
  id              String   @id @default(cuid())
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImageId       String?
  ogImage         Media?   @relation(fields: [ogImageId], references: [id])
  noindex         Boolean  @default(false)
  nofollow        Boolean  @default(false)
  structuredData  Json?
  page            Page?
  project         Project?
  post            Post?
  updatedAt       DateTime @updatedAt
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(308)
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Media {
  id           String   @id @default(cuid())
  url          String
  width        Int?
  height       Int?
  blurDataUrl  String?
  altText      String?
  decorative   Boolean  @default(false)
  filename     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  seoUsages     Seo[]
  projectCovers Project[] @relation("ProjectCoverImage")
  postCovers    Post[]    @relation("PostCoverImage")
}

model Author {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  imageUrl String?
  bio      String?
  sameAs   String[]
  posts    Post[]
}

enum SectionType {
  HERO
  ABOUT
  PROJECTS
  EXPERIENCE
  EDUCATION
  SKILLS
  LANGUAGES
  SERVICES
  TESTIMONIALS
  BLOG
  CONTACT
  RESUME
  NOW
}

model Page {
  id                String        @id @default(cuid())
  slug              String
  locale             String
  translationGroupId String
  title             String
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?
  sections          SectionInstance[]
  seoId             String?       @unique
  seo               Seo?          @relation(fields: [seoId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([slug, locale])
  @@index([translationGroupId])
}

model SectionInstance {
  id        String      @id @default(cuid())
  pageId    String
  page      Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      SectionType
  order     Int
  enabled   Boolean     @default(true)
  content   Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([pageId, order])
}

model Project {
  id                 String        @id @default(cuid())
  slug               String
  locale             String
  translationGroupId String
  title              String
  excerpt            String?
  body               String?
  coverImageId       String?
  coverImage         Media?        @relation("ProjectCoverImage", fields: [coverImageId], references: [id])
  codeRepository     String?
  liveUrl            String?
  programmingLanguages String[]
  tags               Tag[]         @relation("ProjectTags")
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  featured           Boolean       @default(false)
  featuredOrder      Int?
  seoId              String?       @unique
  seo                Seo?          @relation(fields: [seoId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([slug, locale])
  @@index([translationGroupId])
}

model Post {
  id                 String        @id @default(cuid())
  slug               String
  locale             String
  translationGroupId String
  title              String
  excerpt            String?
  body               String?
  coverImageId       String?
  coverImage         Media?        @relation("PostCoverImage", fields: [coverImageId], references: [id])
  authorId           String?
  author             Author?       @relation(fields: [authorId], references: [id])
  tags               Tag[]         @relation("PostTags")
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  seoId              String?       @unique
  seo                Seo?          @relation(fields: [seoId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([slug, locale])
  @@index([translationGroupId])
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  projects Project[] @relation("ProjectTags")
  posts    Post[]    @relation("PostTags")
}

model Experience {
  id          String   @id @default(cuid())
  locale      String
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?
  order       Int      @default(0)
}

model Education {
  id          String    @id @default(cuid())
  locale      String
  institution String
  degree      String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  order       Int       @default(0)
}

model Skill {
  id       String @id @default(cuid())
  locale   String
  name     String
  category String?
  level    Int?
  order    Int    @default(0)
}

// No `locale` (unlike its sibling simple-list models): a tech logo/name isn't
// user-facing prose that gets translated, so per-locale rows would just be
// unused duplication. `imageUrl` is intentionally a plain string rather than
// a Media FK — these are meant to be pasted external logo URLs, not files
// run through the admin's upload/Media pipeline.
model TechStackItem {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?
  order     Int      @default(0)

  @@index([order])
}

model Language {
  id          String @id @default(cuid())
  locale      String
  name        String
  proficiency String
  order       Int    @default(0)
}

model Service {
  id          String  @id @default(cuid())
  locale      String
  title       String
  description String?
  order       Int     @default(0)
}

model Testimonial {
  id         String  @id @default(cuid())
  locale     String
  authorName String
  authorRole String?
  quote      String
  avatarUrl  String?
  order      Int     @default(0)
}

model NavigationItem {
  id       String  @id @default(cuid())
  locale   String
  label    String
  href     String
  order    Int     @default(0)
  parentId String?
  parent   NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavChildren")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}
