generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  isPermanent Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  assignments  UserRoleAssignment[]
  inviteTokens InviteToken[]
}

// Two invariants live only in app code (packages/db/src/auth.ts's
// assertRoleTimeFrame) today; a migration additionally enforces them at the
// DB level via raw SQL Prisma's schema DSL can't express natively:
//   - CHECK: expiresAt IS NULL OR expiresAt > startsAt
//   - TRIGGER: a row referencing an isPermanent Role must have expiresAt NULL
// (Overlapping active assignments for the same user are NOT constrained at
// the DB level — that needs a GiST EXCLUDE constraint requiring the
// btree_gist extension, which may not be creatable on a managed Postgres
// instance without elevated privileges. Left as an app-level invariant
// pending confirmation that CREATE EXTENSION is safe to run there.)
model UserRoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  grantedById String?
  grantedBy   User?     @relation("RoleGrantedBy", fields: [grantedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([userId, startsAt])
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String?
  passwordHash    String
  invitedById     String?
  invitedBy       User?                @relation("UserInvites", fields: [invitedById], references: [id])
  invitees        User[]               @relation("UserInvites")
  sessions        Session[]
  auditLogs       AuditLog[]
  revisions       Revision[]
  sentInvites     InviteToken[]        @relation("SentInvites")
  roleAssignments UserRoleAssignment[]
  grantedRoles    UserRoleAssignment[] @relation("RoleGrantedBy")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model InviteToken {
  id            String    @id @default(cuid())
  // SHA-256 hash of a randomBytes(32) token — the raw token is only ever
  // returned once, at creation, and never persisted (mirrors Session.tokenHash).
  tokenHash     String    @unique
  email         String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  roleExpiresAt DateTime?
  invitedById   String
  invitedBy     User      @relation("SentInvites", fields: [invitedById], references: [id])
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  // Nullable + SetNull: an audit entry is the historical record of what
  // happened, and should survive the acting user being deleted later —
  // it just loses the ability to point at that (now-gone) User row.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Page/Project/Post revisions share one polymorphic table since Prisma can't
// express a true FK across three unrelated target tables — entityId stays a
// free-text cuid, but entityType is a real enum so a typo can't silently
// create an unreachable row (previously a plain String). Revisions
// deliberately are NOT cascade-deleted when their source entity is removed:
// they're the audit/history trail, which should survive deletion of the
// thing it documents, so an orphaned revision after a delete is expected
// behavior, not a bug.
model Revision {
  id          String             @id @default(cuid())
  entityType  RevisionEntityType
  entityId    String
  status      ContentStatus
  data        Json
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())

  previewTokens PreviewToken[]

  @@index([entityType, entityId, createdAt])
}

enum RevisionEntityType {
  Page
  Project
  Post
}

model PreviewToken {
  id        String   @id @default(cuid())
  // SHA-256 hash of a randomBytes(32) token — see InviteToken.tokenHash.
  tokenHash String   @unique
  // entityType/entityId are NOT duplicated here — they previously were,
  // independently of `revision`, with nothing keeping the two in sync. Read
  // them off `revision.entityType`/`revision.entityId` instead.
  revisionId String
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// Seo owns the FK back to whichever single entity it belongs to (rather than
// Page/Project/Post each holding an independent unique FK into Seo). That
// makes "one Seo row per entity" a real constraint instead of a convention:
// the DB now cascades the delete when the owning entity is removed, and a
// CHECK constraint (added in the migration) guarantees at most one of
// pageId/projectId/postId is ever set on a given row.
model Seo {
  id              String   @id @default(cuid())
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImageId       String?
  ogImage         Media?   @relation(fields: [ogImageId], references: [id])
  noindex         Boolean  @default(false)
  nofollow        Boolean  @default(false)
  structuredData  Json?
  pageId          String?  @unique
  page            Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  projectId       String?  @unique
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  postId          String?  @unique
  post            Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(308)
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Media {
  id           String   @id @default(cuid())
  url          String
  width        Int?
  height       Int?
  blurDataUrl  String?
  altText      String?
  decorative   Boolean  @default(false)
  filename     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  seoUsages     Seo[]
  projectCovers Project[] @relation("ProjectCoverImage")
  postCovers    Post[]    @relation("PostCoverImage")
}

model Author {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  imageUrl String?
  bio      String?
  sameAs   String[]
  posts    Post[]
}

enum SectionType {
  HERO
  ABOUT
  PROJECTS
  EXPERIENCE
  EDUCATION
  SKILLS
  LANGUAGES
  SERVICES
  TESTIMONIALS
  BLOG
  CONTACT
  RESUME
  NOW
}

model Page {
  id                String        @id @default(cuid())
  slug              String
  locale             String
  translationGroupId String
  title             String
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?
  sections          SectionInstance[]
  seo               Seo?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([slug, locale])
  @@index([translationGroupId])
}

model SectionInstance {
  id        String      @id @default(cuid())
  pageId    String
  page      Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      SectionType
  order     Int
  enabled   Boolean     @default(true)
  content   Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([pageId, order])
}

model Project {
  id                 String        @id @default(cuid())
  slug               String
  locale             String
  translationGroupId String
  title              String
  excerpt            String?
  body               String?
  coverImageId       String?
  coverImage         Media?        @relation("ProjectCoverImage", fields: [coverImageId], references: [id])
  codeRepository     String?
  liveUrl            String?
  programmingLanguages String[]
  tags               Tag[]         @relation("ProjectTags")
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  featured           Boolean       @default(false)
  featuredOrder      Int?
  seo                Seo?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([slug, locale])
  @@index([translationGroupId])
}

model Post {
  id                 String        @id @default(cuid())
  slug               String
  locale             String
  translationGroupId String
  title              String
  excerpt            String?
  body               String?
  coverImageId       String?
  coverImage         Media?        @relation("PostCoverImage", fields: [coverImageId], references: [id])
  authorId           String?
  author             Author?       @relation(fields: [authorId], references: [id])
  tags               Tag[]         @relation("PostTags")
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  seo                Seo?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([slug, locale])
  @@index([translationGroupId])
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  projects Project[] @relation("ProjectTags")
  posts    Post[]    @relation("PostTags")
}

model Experience {
  id          String   @id @default(cuid())
  locale      String
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?
  order       Int      @default(0)
}

model Education {
  id          String    @id @default(cuid())
  locale      String
  institution String
  degree      String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  order       Int       @default(0)
}

// level is CHECKed (1-5, raw SQL in the migration — see UserRoleAssignment's
// comment for why this isn't expressed in the schema DSL) to match what the
// admin form already labels it: "Level (1-5)".
model Skill {
  id       String @id @default(cuid())
  locale   String
  name     String
  category String?
  level    Int?
  order    Int    @default(0)
}

// No `locale` (unlike its sibling simple-list models): a tech logo/name isn't
// user-facing prose that gets translated, so per-locale rows would just be
// unused duplication. `imageUrl` is intentionally a plain string rather than
// a Media FK — these are meant to be pasted external logo URLs, not files
// run through the admin's upload/Media pipeline.
model TechStackItem {
  id        String   @id @default(cuid())
  name      String   @unique
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Language {
  id          String @id @default(cuid())
  locale      String
  name        String
  proficiency String
  order       Int    @default(0)
}

model Service {
  id          String  @id @default(cuid())
  locale      String
  title       String
  description String?
  order       Int     @default(0)
}

model Testimonial {
  id         String  @id @default(cuid())
  locale     String
  authorName String
  authorRole String?
  quote      String
  avatarUrl  String?
  order      Int     @default(0)
}

model NavigationItem {
  id       String  @id @default(cuid())
  locale   String
  label    String
  href     String
  order    Int     @default(0)
  parentId String?
  parent   NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavChildren")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}
