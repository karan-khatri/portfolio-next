{
  "name": "portfolio-next",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @portfolio/db generate",
    "db:migrate": "pnpm --filter @portfolio/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
